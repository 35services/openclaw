<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    <!-- DEBUG here shows the full rendered prompt and raw LLM output per answer. -->
    <logger name="signalfaqbot" level="DEBUG" />
    <logger name="io.netty" level="WARN" />
</configuration>
